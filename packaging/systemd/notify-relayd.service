[Unit]
Description=notify-relay host service
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/notify-relay/notify-relay.env
ExecStart=%h/.local/bin/notify-relay serve --unix %t/notify-relay.sock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
